# App
APP_ENV=local
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth
AUTH_MODE=dev
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# PostgreSQL
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_MAX_CONCURRENCY=2
LLM_MIN_INTERVAL_MS=2000
EMBED_MIN_INTERVAL_MS=700
LLM_ENABLED=true

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
